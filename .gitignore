# JTE 开源仓库 .gitignore

# 构建产物
jte/bin/
jte/jte
jte/jte.exe
jte/loadtest
jte/loadtest.exe
*.exe
*.dll
*.so
*.dylib
*.test
*.out
*.prof

# 付费模块二进制（永不提交）
jte/modules/bin/
jte/modules/*.so
jte/modules/*.sig
jte/modules/*.dll
jte/modules/*.exe

# 运行时数据（永不提交）
jte/data/
jte/modules/*.json
jte/spool/
jte/logs/

# 测试文件（不进开源仓库）
*_test.go
*.test.js
*.spec.js
*.test.ts
*.spec.ts
jte/coverage.out
jte/coverage.html
jte/coverage/
jte/coverage

# 临时脚本（不进开源仓库）
jte/web/_batch.js
scripts/acceptance_e2e.ps1

# 前端构建产物
jte/web/node_modules/
jte/web/dist/
jte/internal/api/embed/
# cmd/jte/web/dist 为 go:embed all:web 所需，必须入库（AUTO-FIX-2026-09-01：
# 原排除行导致开源克隆缺少内嵌前端，go build 直接失败）

# IDE / 编辑器
.idea/
.vscode/
*.swp
*.swo
*~

# 操作系统
.DS_Store
Thumbs.db

# 敏感文件（永不提交）
*.pem
*.key
.env
.env.local
.env.production
jte/configs/jte.local.yaml

# 开发工具配置（不进开源仓库）
.trae/
.codeartsdoer/
.loopengine/
.mypy_cache/
.ruff_cache/
.uploads/

# 临时文件
*.tmp
*.bak
*.log
jte/stderr.txt
jte/stdout.txt
