# JTE 开源仓库 .gitignore

# 构建产物
jte/bin/
jte/jte
jte/jte.exe
jte/loadtest
jte/loadtest.exe
*.exe
*.dll
*.so
*.dylib
*.test
*.out
*.prof
# modules/bin/ 下的预编译模块二进制和签名文件允许提交
!jte/modules/bin/
!jte/modules/bin/**

# 运行时数据（永不提交）
jte/data/
jte/modules/*.json
jte/spool/
jte/logs/

# 前端构建产物
jte/web/node_modules/
jte/web/dist/
# internal/api/embed/ 是旧版前端构建产物，不再入库
jte/internal/api/embed/
# cmd/jte/web/dist/ 是 go:embed 需要的前端产物，允许提交
!jte/cmd/jte/web/dist/

# 覆盖率
jte/coverage.out
jte/coverage.html
jte/coverage/
jte/coverage

# IDE / 编辑器
.idea/
.vscode/
*.swp
*.swo
*~

# 操作系统
.DS_Store
Thumbs.db

# 敏感文件（永不提交）
*.pem
*.key
.env
.env.local
.env.production
jte/configs/jte.local.yaml

# 开发工具配置（不进开源仓库）
.trae/
.codeartsdoer/
.loopengine/
.mypy_cache/
.ruff_cache/
.uploads/

# 临时文件
*.tmp
*.bak
*.log
jte/stderr.txt
jte/stdout.txt
